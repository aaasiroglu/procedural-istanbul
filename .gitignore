# dependencies and build output
node_modules/
dist/

# raw downloads (PLATEAU CityGML and textures, OSM, GSI DEM): several GB per area - re-create with `npm run fetch`
data/raw/
data/preview/
data/ibb-local/network.gdb/
*.part
*.bak

# compiled city - re-create with `npm run compile`
public/tiles/
# CC0 textures - re-create with `node tools/assets/fetch_textures.mjs`
public/textures/
# GSI aerial photo tiles - re-create with `npm run fetch`
public/ortho/
# İBB live traffic archive (npm run archive:ibb): grows ~20 MB a day
data/archive/
# SUMO networks and scenarios (tools/sumo): re-create with the build scripts
data/sumo/
# OD estimates (npm run od:corridor)
data/od/
# İBB open data downloads (data.ibb.gov.tr): re-create with the download scripts
data/ibb-open/

# local settings and secrets
.env
.env.*
!.env.example
.claude/
.venv/
scratch/
__pycache__/
*.pyc

# logs, caches, editors, operating system
*.log
npm-debug.log*
.vite/
.cache/
*.tsbuildinfo
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
