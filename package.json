{
  "name": "procedural-istanbul",
  "version": "0.1.0",
  "private": true,
  "description": "An open traffic digital twin of Istanbul in the browser, with a model that estimates travel demand from road speeds",
  "author": "Abdurrahim Arif Aşıroğlu <aaasiroglu@outlook.com>",
  "homepage": "https://aaasiroglu.github.io/procedural-istanbul/",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaasiroglu/procedural-istanbul.git"
  },
  "bugs": {
    "url": "https://github.com/aaasiroglu/procedural-istanbul/issues"
  },
  "keywords": [
    "istanbul",
    "digital-twin",
    "traffic",
    "threejs",
    "sumo",
    "origin-destination",
    "open-data"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "fetch": "node tools/pipeline/fetch.mjs",
    "compile": "node --max-old-space-size=4096 tools/pipeline/compile.mjs",
    "prepare:ibb-grid": "python tools/pipeline/ibb_grid.py",
    "fetch:ibb-grid": "node tools/pipeline/ibb_batch.mjs fetch",
    "compile:ibb-grid": "node tools/pipeline/ibb_batch.mjs compile",
    "preview": "node tools/pipeline/preview.mjs",
    "deploy": "node tools/deploy.mjs",
    "test": "node tools/tests/tileformat.test.mjs && node tools/tests/road-markings.test.mjs && node tools/tests/predictive-routing.test.mjs",
    "archive:ibb": "uv run tools/archive/ibb_speeds.py",
    "test:od": "uv run python tools/od/test_odme.py",
    "sumo:net": "uv run --group sumo python tools/sumo/build_net.py",
    "sumo:map-ibb": "uv run --group sumo python tools/sumo/map_ibb.py",
    "sumo:smoke": "uv run --group sumo python tools/sumo/smoke_test.py",
    "od:corridor": "uv run --group sumo python tools/od/corridor.py",
    "build:site": "vite build --outDir docs/app --emptyOutDir"
  },
  "license": "MIT",
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@takram/three-atmosphere": "^0.19.1",
    "@takram/three-clouds": "^0.7.6",
    "@takram/three-geospatial": "^0.9.1",
    "@takram/three-geospatial-effects": "^0.6.4",
    "earcut": "^3.2.4",
    "lil-gui": "^0.21.0",
    "n8ao": "^2.0.1",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "vite": "^8.3.2"
  }
}
